# Copy to .env and fill in. .env is gitignored and holds real secrets;
# this file is committed and must never contain any.
#
# It exists because the real .env was once deleted with no way to
# reconstruct it — the app kept running on values already loaded in memory,
# and would have locked its owner out on the next restart.

# Local Postgres (Homebrew, no password by default).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trader
DB_USER=your-macos-username
DB_PASSWORD=

# Default per-trade fee, in dollars.
DEFAULT_FEE=4

# The single shared password, as a bcrypt hash — never the password itself.
# Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# Without this set, every login is rejected.
APP_PASSWORD_HASH=

# AI summary. The feature degrades gracefully when unset: the endpoint
# reports configured:false and the UI says it isn't set up, rather than
# erroring. Get a free key from Google AI Studio (no credit card).
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional; defaults to a Flash model if omitted.
LLM_MODEL=
